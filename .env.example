# GEMINI_API_KEY: Required for server-side Gemini AI generation (Tutor, Dialogue, Evaluations, Quests).
# In Google AI Studio, this is managed securely in the Secrets panel.
# In custom cloud deployments (e.g. Cloud Run, Docker), pass as an environment variable secret.
GEMINI_API_KEY="your-gemini-api-key-here"

# APP_URL: The public canonical URL where this application is hosted.
# Automatically set in AI Studio Cloud Run deployments.
APP_URL="https://your-domain.com"

# NODE_ENV: Set to 'production' for live deployments to enforce JWT signature checks and strict security gates.
NODE_ENV="production"

# PORT: Port for the backend server (default 3000 in container environments).
PORT=3000

